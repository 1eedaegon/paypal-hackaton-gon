# PayPal REST app credentials (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
# Id of the webhook registered for <your-url>/api/webhooks/paypal. Leave empty for local development.
PAYPAL_WEBHOOK_ID=

# Google AI Studio key (https://aistudio.google.com/api-keys)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: comma separated models tried in order
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview

# Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional
# PORT=8080
# COOKIE_SECURE=true          # set when served over HTTPS
# STATIC_DIR=../web/dist
# AGENT_DAILY_LIMIT=40        # agent runs per user per day
# GLOBAL_AGENT_DAILY_LIMIT=1200
# INVOICE_DAILY_LIMIT=25
